{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "remote",
      "url": "http://localhost:8931/mcp",
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": false
    },
    "miro-mcp": {
      "type": "remote",
      "url": "https://mcp.miro.com/", 
      "enabled": false,
      "autoApprove": []
    }
  },
  "skills": {
    "path": "./.opencode/skills"
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}